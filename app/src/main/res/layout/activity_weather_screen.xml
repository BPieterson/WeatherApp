    <TextView
        android:id="@+id/lbl6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42dp"
        android:text="Saturday:"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/lbl7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.051"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/txtMxWed"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:ems="10"
        android:inputType="number"
        app:layout_constraintBottom_toTopOf="@+id/txtMxThu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.341"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spThu"
        android:layout_width="80dp"
        android:layout_height="45dp"
        android:layout_marginBottom="19dp"
        android:dropDownWidth="match_parent"
        android:entries="Sunny, Raining/Showers, Cloudy/Overcast, Partly Cloudy, Snowing, Windy, Cold, Hot"
        android:spinnerMode="dropdown"
        app:layout_constraintBottom_toTopOf="@+id/spFri"
        app:layout_constraintEnd_toEndOf="@+id/spWed"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/lblCondition"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:layout_marginTop="45dp"
        android:layout_marginBottom="7dp"
        android:text="Weather Condition"
        android:textAlignment="center"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/spMon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.897"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headin" />

    <Spinner
        android:id="@+id/spMon"
        android:layout_width="80dp"
        android:layout_height="45dp"
        android:layout_marginBottom="9dp"
        android:dropDownWidth="match_parent"
        android:entries="Sunny, Raining/Showers, Cloudy/Overcast, Partly Cloudy, Snowing, Windy, Cold, Hot"
        android:spinnerMode="dropdown"
        app:layout_constraintBottom_toTopOf="@+id/spTue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.897"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spTue"
        android:layout_width="80dp"
        android:layout_height="45dp"
        android:layout_marginBottom="10dp"
        android:dropDownWidth="match_parent"
        android:entries="Sunny, Raining/Showers, Cloudy/Overcast, Partly Cloudy, Snowing, Windy, Cold, Hot"
